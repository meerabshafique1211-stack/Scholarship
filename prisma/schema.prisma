// Global Scholarship Finder — database schema (v2)
// Universities and scholarships are separate. A university coming from an open
// dataset says nothing about scholarships; every scholarship is verified on its own.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Universities ─────────────────────────────

enum UniversityStatus {
  IMPORTED // from an open dataset (Hipo), domain recorded, not manually checked
  VERIFIED // official website checked by an admin
  REJECTED // defunct, duplicate or not a real institution — never shown
}

model University {
  id                 String           @id @default(cuid())
  name               String
  normalizedName     String
  countryCode        String           @db.Char(2)
  country            String
  city               String?
  state              String?
  officialWebsite    String?
  officialDomain     String           @unique // primary dedupe key
  domains            String[]
  logoUrl            String?
  openalexId         String?          @unique
  rorId              String?
  institutionType    String?          // from OpenAlex, e.g. "education"
  worksCount         Int?
  citedByCount       Int?
  source             String           // "HIPO" | "MANUAL_OFFICIAL"
  sourceUrl          String
  researchSource     String?          // "OPENALEX"
  researchSourceUrl  String?
  verificationStatus UniversityStatus @default(IMPORTED)
  lastVerifiedAt     DateTime
  sourceId           String?
  source             DataSource?      @relation(fields: [sourceId], references: [id])
  scholarships       Scholarship[]
  programs           Program[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([countryCode])
  @@index([normalizedName, countryCode])
}

model SyncRun {
  id          String   @id @default(cuid())
  job         String   // "universities" | "scholarship-expiry"
  countryCode String?
  provider    String?
  inserted    Int      @default(0)
  updated     Int      @default(0)
  skipped     Int      @default(0)
  error       String?
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
}

// ───────────────────────────── Scholarships ─────────────────────────────

enum ScholarshipVerification {
  VERIFIED           // checked against the official source
  NEEDS_VERIFICATION // discovered, not yet checked — admin only
  EXPIRED            // was verified, official deadline has passed
  REJECTED           // source could not be verified or looked unreliable
}

enum FundingType {
  FULLY_FUNDED   // tuition + substantial living support (stipend / housing / insurance / travel)
  FULL_TUITION   // 100% tuition only
  PARTIAL        // a published % of tuition
  TUITION_WAIVER // fee waiver / reduction not expressed as %
  OTHER          // grant, allowance, merit award of a published amount
}

enum SourceType {
  UNIVERSITY_OFFICIAL
  GOVERNMENT_OFFICIAL
  ERASMUS_OFFICIAL
  SCHOLARSHIP_PROVIDER_OFFICIAL
}

enum DegreeLevel {
  BACHELOR
  MASTER
  PHD
}

enum NationalityRule {
  ALL             // open to all nationalities per the official text
  ONLY_LISTED
  ALL_EXCEPT_LISTED
}

model Scholarship {
  id                     String                  @id @default(cuid())
  name                   String
  universityId           String?                 // null for government / provider schemes
  university             University?             @relation(fields: [universityId], references: [id])
  providerName           String
  providerDomain         String                  // official domain the source pages must live on
  countryCode            String                  @db.Char(2)
  degreeLevels           DegreeLevel[]
  studyFields            String[]                // empty = all fields per official text
  nationalityRule        NationalityRule
  nationalities          String[]                // ISO-2 codes; "EU_EEA" token allowed
  eligibilityText        String                  // eligibility summary as published

  fundingType            FundingType
  fundingPercentage      Int?
  fundingAmountText      String?                 // amount as published, e.g. "€9,000 per year"
  tuitionCoverage        Boolean?                // null = not stated in source
  livingStipend          String?
  accommodation          Boolean?
  healthInsurance        Boolean?
  travelSupport          Boolean?
  applicationFee         String?
  otherBenefits          String?                 // as published, e.g. "language course"

  cycle                  String                  // e.g. "2027-28"
  intake                 String?                 // e.g. "2027-09"
  openingDate            DateTime?               // OFFICIAL dates only — never inferred
  deadline               DateTime?
  statusUndetermined     Boolean                 @default(false) // source exists but status unclear → UNKNOWN
  previousCycleLabel     String?                 // historical, e.g. "2026-27"
  previousCycleDeadline  DateTime?               // shown only as history

  officialScholarshipUrl String
  officialApplicationUrl String?                 // only when the official portal exists
  sourceUrl              String
  sourceType             SourceType

  verificationStatus     ScholarshipVerification @default(NEEDS_VERIFICATION)
  verificationNotes      String?
  lastVerifiedAt         DateTime?               // set ONLY by a human verification
  sourceContentHash      String?                 // fingerprint of the official page at verification time
  sourceLastCheckedAt    DateTime?               // last automatic check (never counts as verification)
  isDemo                 Boolean                 @default(false) // must be false for public results
  sourceId               String?
  source                 DataSource?             @relation(fields: [sourceId], references: [id])

  sources                ScholarshipSource[]
  logs                   VerificationLog[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([verificationStatus, isDemo, countryCode])
  @@index([deadline])
  @@index([sourceLastCheckedAt])
}

// Every official page checked for a scholarship, with the date it was checked.
model ScholarshipSource {
  id                 String                  @id @default(cuid())
  scholarshipId      String
  scholarship        Scholarship             @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  sourceType         SourceType
  sourceUrl          String
  providerName       String
  lastChecked        DateTime
  verificationStatus ScholarshipVerification

  @@index([scholarshipId])
}

model VerificationLog {
  id            String      @id @default(cuid())
  scholarshipId String
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  action        String      // created | updated | verified | rejected | expired | auto_expired
  note          String?
  actor         String
  createdAt     DateTime    @default(now())

  @@index([scholarshipId, createdAt])
}

// ───────────────────────── Phase 1: data foundation ─────────────────────────

enum RecordVerification {
  VERIFIED           // every published field checked against the official source
  PARTIALLY_VERIFIED // some fields checked; unchecked fields are shown as "not verified"
  NEEDS_REVIEW       // imported or changed; admin only
  EXPIRED            // past cycle / withdrawn
  UNKNOWN
}

enum DataSourceType {
  OFFICIAL_API
  OFFICIAL_DATASET
  OFFICIAL_WEBSITE
  GOVERNMENT
  SCHOLARSHIP_PROVIDER
  APPROVED_SECONDARY
  MANUAL
}

enum DataSourceStatus {
  ACTIVE
  PLANNED
  PAUSED
  ERROR
  BLOCKED_LICENSE // licence does not allow our use (e.g. needs written permission)
}

enum CommercialUse {
  ALLOWED
  NEEDS_PERMISSION
  NOT_ALLOWED
  UNKNOWN
}

enum SyncFrequency {
  DAILY
  WEEKLY
  MONTHLY
  MANUAL
}

// Registry of every place data comes from, with its licence. Connectors read this.
model DataSource {
  id             String           @id
  name           String
  sourceType     DataSourceType
  apiUrl         String?
  websiteUrl     String
  license        String?
  attribution    String?
  commercialUse  CommercialUse    @default(UNKNOWN)
  coverage       String?
  providesFields String[]
  syncFrequency  SyncFrequency    @default(MANUAL)
  lastSyncAt     DateTime?
  status         DataSourceStatus @default(PLANNED)
  lastError      String?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  programs       Program[]
  changes        RecordChange[]
  scholarships   Scholarship[]
  universities   University[]
}

model Program {
  id                     String             @id @default(cuid())
  universityId           String
  university             University         @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name                   String
  slug                   String
  degreeLevel            DegreeLevel
  subjects               String[]
  languages              String[]
  durationMonths         Int?
  tuitionAmount          Decimal?           @db.Decimal(12, 2)
  tuitionCurrency        String?            @db.Char(3)
  tuitionPeriod          String?            // "YEAR" | "TOTAL" | "SEMESTER"
  tuitionAppliesTo       String?            // "INTERNATIONAL" | "DOMESTIC" | "ALL" | "UNKNOWN"
  intakes                String[]
  applicationFeeText     String?
  englishRequirementText String?
  ieltsMin               Decimal?           @db.Decimal(3, 1)
  toeflMin               Int?
  gpaRequirementText     String?
  officialUrl            String
  applicationUrl         String?
  sourceId               String?
  source                 DataSource?        @relation(fields: [sourceId], references: [id])
  sourceUrl              String
  verificationStatus     RecordVerification @default(NEEDS_REVIEW)
  lastVerifiedAt         DateTime?
  lastCheckedAt          DateTime?
  deadlines              ProgramDeadline[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([universityId, slug])
  @@index([degreeLevel])
  @@index([verificationStatus])
}

// Official deadlines only. A cycle without a published date has no row here.
model ProgramDeadline {
  id               String   @id @default(cuid())
  programId        String
  program          Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  intake           String   // e.g. "2027-10"
  label            String   // e.g. "Application deadline (non-EU)"
  applicantGroup   String   @default("ALL")
  deadline         DateTime
  deadlineTimeText String?  // e.g. "23:59 CET"
  sourceUrl        String
  lastVerifiedAt   DateTime
  createdAt        DateTime @default(now())

  @@index([programId])
  @@index([deadline])
}

// Field-level change history for any record (tuition, deadlines, requirements...).
model RecordChange {
  id         String      @id @default(cuid())
  entityType String      // "Program" | "Scholarship" | "University" | "ProgramDeadline"
  entityId   String
  field      String
  oldValue   String?
  newValue   String?
  sourceId   String?
  source     DataSource? @relation(fields: [sourceId], references: [id])
  detectedAt DateTime    @default(now())
  reviewedAt DateTime?
  actor      String      // "cron:<connector>" | "admin"

  @@index([entityType, entityId, detectedAt], map: "RecordChange_entity_idx")
}
