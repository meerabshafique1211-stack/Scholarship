# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.

# PostgreSQL (e.g. Neon via Vercel → Storage). Without it, scholarship results are empty by design.
DATABASE_URL=""

# Admin access to /admin
ADMIN_PASSWORD=""
AUTH_SECRET=""          # long random string used to sign the admin session cookie

# Vercel Cron authentication for /api/cron/sync
CRON_SECRET=""

# Optional: OpenAlex enrichment (free key from openalex.org/settings/api). Disabled when empty.
OPENALEX_API_KEY=""

# Flag verified scholarships for re-checking after this many days
REVERIFY_AFTER_DAYS="30"
