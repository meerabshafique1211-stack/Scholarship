# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.

# PostgreSQL. For Supabase use the TRANSACTION POOLER string (port 6543) and append
# ?pgbouncer=true&connection_limit=1 — required for Prisma on serverless (Vercel).
# Supabase → Connect → ORMs → Prisma shows the exact string. Server-side only; never NEXT_PUBLIC_.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Admin access to /admin
ADMIN_PASSWORD=""
AUTH_SECRET=""          # long random string used to sign the admin session cookie

# Vercel Cron authentication for /api/cron/sync
CRON_SECRET=""

# Optional: OpenAlex enrichment (free key from openalex.org/settings/api). Disabled when empty.
OPENALEX_API_KEY=""

# Flag verified scholarships for re-checking after this many days
REVERIFY_AFTER_DAYS="30"
