# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.

# PostgreSQL. For Supabase use the TRANSACTION POOLER string (port 6543) and append
# ?pgbouncer=true&connection_limit=1 — required for Prisma on serverless (Vercel).
# Supabase → Connect → ORMs → Prisma shows the exact string. Server-side only; never NEXT_PUBLIC_.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Admin access to /admin
ADMIN_PASSWORD=""
AUTH_SECRET=""          # long random string used to sign the admin session cookie

# Vercel Cron authentication for /api/cron/sync
CRON_SECRET=""

# Optional: OpenAlex enrichment (free key from openalex.org/settings/api). Disabled when empty.
OPENALEX_API_KEY=""

# Flag verified scholarships for re-checking after this many days
REVERIFY_AFTER_DAYS="30"

# Public site URL used for canonical links, sitemap and structured data (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://scholarship-project-sigma.vercel.app"

# Contact address shown on /contact and /privacy (public)
NEXT_PUBLIC_CONTACT_EMAIL=""

# Optional AI for CV feedback and motivation-letter drafts (server-side only)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Google AdSense (public identifiers only; leave empty to show no ads at all)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""          # e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=""
NEXT_PUBLIC_ADSENSE_SLOT_RESPONSIVE=""
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=""
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=""

# Optional: Google Search Console verification token
GOOGLE_SITE_VERIFICATION=""

# Real name of the person or organisation running the site (shown on /about). Never leave a fake name.
NEXT_PUBLIC_PUBLISHER_NAME=""
